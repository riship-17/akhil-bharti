# MongoDB connection (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/abrsm_conference

# Admin panel login (/admin)
ADMIN_PASSWORD=change-this-password
# Any long random string — used to sign admin sessions
JWT_SECRET=replace-with-a-long-random-string

PORT=5050

# Email via Resend (https://resend.com → API Keys). Leave empty to disable email.
# MAIL_FROM must use a domain you have verified in Resend (Domains → Add domain).
# Until then use onboarding@resend.dev, which only delivers to your own Resend account email.
RESEND_API_KEY=
MAIL_FROM="ABRSM Gujarat <onboarding@resend.dev>"
# Optional: where participants' replies go, e.g. abrsmgujarat@gmail.com
MAIL_REPLY_TO=

# Optional: Razorpay online payment (Dashboard → Account & Settings → API Keys).
# Leave empty to fall back to manual UPI QR + UTR + screenshot.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: secret you set on the webhook (Dashboard → Webhooks,
# URL https://<your-site>/api/pay/webhook, events payment.captured and order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Optional: WhatsApp Bhojan Pass via AiSensy (see README). All three are needed to send.
AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=
# Public https address of the site, e.g. https://abrsm2026.example.org
PUBLIC_URL=
